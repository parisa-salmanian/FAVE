# Normalize line endings so checkouts on Windows don't get CRLF noise.
* text=auto eol=lf

# Binary file types — never try to diff or normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gpkg binary
*.xlsx binary
*.pdf binary

# Large building / boundary geojsons (40-130 MB each) live in Git LFS so
# the regular git history stays small. The runtime fetcher in tools/ is
# still around as a fallback for partial downloads or self-hosting.
frontend/assets/data/byggnad_*.geojson filter=lfs diff=lfs merge=lfs -text
frontend/assets/data/lantmateriat-byggnadsverk-buildings-wgs84-11-12-2024.geojson filter=lfs diff=lfs merge=lfs -text
frontend/assets/data/bldg_web.geojson filter=lfs diff=lfs merge=lfs -text

# Baked accessibility/transit products (large compact JSON, up to ~44 MB each) —
# LFS like the building geojsons so plain git history stays small.
frontend/assets/data/cities/*/access2sfca/*.json filter=lfs diff=lfs merge=lfs -text
frontend/assets/data/cities/*/transit/*.json filter=lfs diff=lfs merge=lfs -text
