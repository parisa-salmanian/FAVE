# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.venv-transit/

# --- Transit bake tooling (dev-only; never commit; see tools/transit/RUNBOOK.md) ---
# GTFS feeds, per-city OSM crops, and JVM crash logs.
tools/transit/*.zip
tools/transit/osm_crops/
tools/transit/hs_err_pid*.log

# --- OSRM dev data (multi-GB, regenerable via tools/osrm/setup_osrm.sh) ---
# The Sweden OSM extract (769 MB) exceeds GitHub's 100 MB limit; the processed
# .osrm graphs are several GB. Never commit — only the scripts/compose/runbook.
tools/osrm/data/

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Node ---
node_modules/

# --- Runtime / cache / job output (per-run; never commit) ---
api_data/
frontend/assets/data/cache/

# --- Large data files: tracked via Git LFS, not ignored. ---
# (see .gitattributes for the LFS pattern list.)
# These two are tooling-only and not needed at runtime, so still ignored:
frontend/assets/data/sweden_regso.geojson
frontend/assets/data/all_sweden_regso.geojson
frontend/assets/data/DeSO_2025.gpkg

# --- Backups (local-only, never commit) ---
*.bak
*.geojson.bak

# --- Lantmäteriet downloads (local-only; ~3-4 GB for all of Sweden) ---
# Run tools/fetch_lantmateriet_buildings.py to populate this folder.
lantmateriet/

# --- Secrets (NEVER commit) ---
.env
.lantmateriet_credentials
